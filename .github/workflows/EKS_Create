name: Create EKS Cluster

on:
  workflow_dispatch:

jobs:
  create-cluster:
    runs-on: self-hosted

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Create EKS Cluster
        run: |
          eksctl create cluster \
            --name voting1 \
            --region us-east-1 \
            --node-type t3.medium \
            --nodes 2 \
            --node-volume-size 20 \
            --spot \
            --managed \
            --node-private-networking=false \
            --vpc-nat-mode Disable \
            --zones us-east-1a,us-east-1b
